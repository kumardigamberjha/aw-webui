# ─────────────────────────────────────────────────────────────────
# aw-webui — Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local overrides (never commit .env.local).
# Variables injected via vite.config.js / vue.config.js at build time.
# ─────────────────────────────────────────────────────────────────

# ── ActivityWatch Server ──────────────────────────────────────────
# Base URL of the aw-server instance the Web UI connects to.
# In dev mode this defaults to http://127.0.0.1:5666 (testing server).
# In production mode the UI uses the origin it is served from (empty string).
# Set this when you want to point the dev build at a non-default server,
# e.g. your production instance at port 5600.
#
# Example: AW_SERVER_URL="'http://localhost:5600'"
# Note: the value must include inner quotes because it is injected with
#       DefinePlugin / vite define (raw string replacement in source code).
AW_SERVER_URL="'http://localhost:5600'"

# ── Build / CI metadata ───────────────────────────────────────────
# Short Git commit hash injected into the build.
# In vue.config.js this is auto-detected via `git rev-parse --short HEAD`.
# In vite.config.js it must be supplied here (e.g. by your CI pipeline).
# Leave empty locally; the build will use "undefined" gracefully.
COMMIT_HASH=

# ── Platform flag ─────────────────────────────────────────────────
# Set to "true" when building/serving the UI inside the Android WebView
# (ActivityWatch for Android). Controls which views are shown by default
# and disables the "new release" check.
# Leave empty (or unset) for all desktop/browser deployments.
VUE_APP_ON_ANDROID=false

# ── Node environment (managed by npm scripts — do not change here) ─
# Automatically set to "development" by `npm run serve` / vite dev server,
# and to "production" by `npm run build`. Documented here for reference only.
# NODE_ENV=development
